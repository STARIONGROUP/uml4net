<?xml version="1.0" encoding="UTF-8"?>
<!-- a relative href to a document in a sibling folder; that document in turn refers to a sibling of its own -->
<xmi:XMI xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20131001">
  <uml:Package xmi:id="p" name="Models">
    <packagedElement xmi:type="uml:Class" xmi:id="A" name="A">
      <ownedAttribute xmi:type="uml:Property" xmi:id="A-t" name="t">
        <type href="../lib/types.xmi#T"/>
      </ownedAttribute>
    </packagedElement>
  </uml:Package>
</xmi:XMI>
