<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Version>9.4.0</Version>
        <LangVersion>12.0</LangVersion>
        <PackageId>uml4net.Extensions</PackageId>
        <AssemblyTitle>uml4net.Extensions</AssemblyTitle>
        <Title>uml4net.Extensions</Title>
        <Description>Extension methods for the .NET implementation of the OMG UML v2.5.1 specification.</Description>
        <PackageTags>UML modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Add] QueryRedefinitionChainEnd, QueryIsDerivedByRedefinition and QueryIsSameNameRedefinition property extension methods that follow redefinition chains in the context of a class; see #537
            [Add] QueryIntroducedNonDerivedProperties class extension method returning the non-derived properties a class introduces, excluding same-name redefinitions; see #537
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\uml4net\uml4net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" />
    </ItemGroup>
</Project>
