<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFramework>netstandard2.0</TargetFramework>
      <Version>5.1.0</Version>
      <LangVersion>12.0</LangVersion>
      <PackageId>uml4net</PackageId>
      <AssemblyTitle>uml4net</AssemblyTitle>
      <Title>uml4net</Title>
      <Description>A .NET implementation of the OMG UML v2.5.1 specification.</Description>
      <PackageTags>UML modeltopia</PackageTags>
      <PackageReleaseNotes>
          [Fix] Namespace::importedMember and getNamesOfMember stop at PackageImport cycles instead of overflowing the stack; fixes #490
          [Fix] ReplyAction::input contains the replyValue pins; fixes #491
          [Fix] ContainerList keeps an element owned while another list of its container holds it, moves it between containers and maintains containment through IList; fixes #492
          [Fix] Property::opposite is null instead of throwing for a property that is not a member end of its association, and uses the owning association; fixes #495
          [Fix] Classifier::directlyUsedInterfaces follows the specification text: Usages from the Classifier to Interfaces; fixes #497
          [Fix] IClassifier.General of Class and its subtypes returns every parent instead of forwarding to superClass; fixes #494
      </PackageReleaseNotes>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>
</Project>
