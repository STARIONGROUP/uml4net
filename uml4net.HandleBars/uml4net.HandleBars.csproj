<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Version>9.2.0</Version>
        <LangVersion>12.0</LangVersion>
        <PackageId>uml4net.HandleBars</PackageId>
        <AssemblyTitle>uml4net.HandleBars</AssemblyTitle>
        <Title>uml4net.HandleBars</Title>
        <Description>HandleBars Helpers for use in combination with the uml4net library to support HandleBarHelpers based code generation</Description>
        <PackageTags>UML HandleBars modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Fix] Faulty Handlebars helpers in uml4net.HandleBars; fixes #508
            [Add] Class and Classifier Handlebars helpers; fixes #511
            [Add] Property Handlebars helpers; fixes #511
            [Add] Element Handlebars helpers for annotating comments and a documentation summary; fixes #511
            [Add] Handlebars helpers that SysML2.NET, EORSADB and mycelium share; fixes #512
            [Add] C# identifier naming with escaping of reserved keywords; fixes #513
            [Update] Handlebars.Net to 2.4.3 and Stef.Validation to 0.3.0
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\uml4net.Extensions\uml4net.Extensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Handlebars.Net.Helpers" />
    </ItemGroup>

    <!-- Lifts transitive dependencies of Handlebars.Net.Helpers above the versions it was built against
         (Handlebars.Net 2.1.6, Stef.Validation 0.1.1). Transitive pinning is disabled solution-wide, so a
         direct reference is the only way to raise them. Remove once Handlebars.Net.Helpers ships against
         these versions or newer. -->
    <ItemGroup Label="lift transitive Handlebars dependencies">
        <PackageReference Include="Handlebars.Net" />
        <PackageReference Include="Stef.Validation" />
    </ItemGroup>

    <!-- Deliberate security override, NOT a normal dependency: forces the transitively-referenced
         System.Private.Uri up to a patched version (see the version pin and rationale in
         Directory.Packages.props). Remove this ItemGroup only once no transitive dependency pulls in
         a vulnerable System.Private.Uri version. -->
    <ItemGroup Label="override transitive vulnerable dependency">
        <PackageReference Include="System.Private.Uri" />
    </ItemGroup>
</Project>
