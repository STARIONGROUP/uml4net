<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Version>9.0.0</Version>
        <LangVersion>12.0</LangVersion>
        <PackageId>uml4net.HandleBars</PackageId>
        <AssemblyTitle>uml4net.HandleBars</AssemblyTitle>
        <Title>uml4net.HandleBars</Title>
        <Description>HandleBars Helpers for use in combination with the uml4net library to support HandleBarHelpers based code generation</Description>
        <PackageTags>UML HandleBars modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Fix] forward redefined properties to their redefining property instead of throwing; fixes #232
            [Fix] generate derived composite properties as List instead of IContainerList; fixes #286
            [Fix] implement Element.OwnedElement derived property; fixes #288
            [Improvement] return IReadOnlyList for derived/read-only collection properties; fixes #291
            [Feature] read any UML element as an XMI document root; part of #77
            [Fix] read value and skipped elements in place so compact XMI is read completely; fixes #362
            [Fix] parse Boolean, Integer and Real values per XML Schema lexical forms; fixes #364
            [Fix] write enumeration values with the literal names of the UML metamodel; fixes #376
            [Fix] ignore serialized derived properties instead of throwing in strict mode; fixes #367
            [Fix] report invalid enumeration literals, repeated single-valued references and duplicate xmi:id with element, property and position; fixes #371
            [Fix] Property::isComposite is aggregation = composite only; the Enterprise Architect accommodation moves to QueryIsContainment; fixes #345
            [Fix] set the owner end of a composite association on containment, and do not write it; fixes #432
            [Breaking] optional [0..1] Boolean, Integer, Real and Enumeration properties are nullable; fixes #357, fixes #347
            [Breaking] derived composite properties are exposed as IReadOnlyList; fixes #358
            [Fix] untyped elements produce valid C# type names; fixes #395
            [Fix] the writer always writes a mandatory value without a metamodel default; fixes #375
            [Feature] the writer can write Canonical XMI (XMI 2.5.1 Annex B) with the UseCanonicalXmi setting; fixes #385
            [Improvement] single-valued composite properties enforce their upper bound; fixes #480
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\uml4net.Extensions\uml4net.Extensions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Handlebars.Net.Helpers" />
    </ItemGroup>

    <!-- Deliberate security override, NOT a normal dependency: forces the transitively-referenced
         System.Private.Uri up to a patched version (see the version pin and rationale in
         Directory.Packages.props). Remove this ItemGroup only once no transitive dependency pulls in
         a vulnerable System.Private.Uri version. -->
    <ItemGroup Label="override transitive vulnerable dependency">
        <PackageReference Include="System.Private.Uri" />
    </ItemGroup>
</Project>
